{
  "name": "saucedemo-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Risk-based end-to-end test suite for saucedemo.com, built with Playwright and TypeScript",
  "engines": {
    "node": "^24.21.0"
  },
  "scripts": {
    "postinstall": "playwright install chromium",
    "test": "playwright test --project=chromium",
    "test:all-browsers": "playwright install firefox webkit && playwright test",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "eslint": "10.10.0",
    "eslint-plugin-playwright": "2.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
